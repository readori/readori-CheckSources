[Unit]
Description=Readori AMD Micro source validation executor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=readori
Group=readori
WorkingDirectory=/opt/readori-validator
EnvironmentFile=/etc/readori-validator/amd-micro.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/readori-validator/.venv/bin/python -m server.amd_micro_executor --work-dir /var/lib/readori-validator --poll-seconds 2
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/readori-validator
MemoryMax=850M
TasksMax=32

[Install]
WantedBy=multi-user.target
