[Unit]
Description=Readori AMD Micro source validation server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=readori
Group=readori
WorkingDirectory=/opt/readori-validator
EnvironmentFile=/etc/readori-validator/amd-micro.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/readori-validator/.venv/bin/python -m server.source_validator_server --host 0.0.0.0 --port 8787
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/readori-validator
MemoryMax=850M
TasksMax=32

[Install]
WantedBy=multi-user.target
