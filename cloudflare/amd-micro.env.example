# Cloudflare control plane
READORI_AMD_EXECUTOR_BASE_URL=https://validator.example.com
READORI_AMD_EXECUTOR_TOKEN=replace-with-wrangler-secret
READORI_CF_ACCOUNT_ID=replace-with-cloudflare-account-id
READORI_CF_QUEUE_ID=replace-with-queue-id
READORI_CF_QUEUE_API_TOKEN=replace-with-queues-read-write-token

# AMD Micro safety profile
READORI_AMD_EXECUTOR_ID=amd-micro-01
READORI_VALIDATOR_EXECUTOR_PROFILE=amd-micro
READORI_AMD_WORK_DIR=/var/lib/readori-validator
READORI_AMD_POLL_SECONDS=2
READORI_AMD_MAX_ATTEMPTS=3
READORI_CF_QUEUE_VISIBILITY_TIMEOUT_MS=43200000
