# Server-only mode: the Worker keeps this token secret and sends it as
# x-api-key. No Cloudflare D1/R2/Queue credentials are required.
READORI_VALIDATOR_API_KEY=replace-with-a-long-random-token
READORI_VALIDATOR_HOST=0.0.0.0
READORI_VALIDATOR_PORT=8787
READORI_VALIDATOR_DB=/var/lib/readori-validator/validator.sqlite3
READORI_VALIDATOR_EXECUTOR_PROFILE=amd-micro
READORI_AMD_MICRO=1
READORI_VALIDATOR_MAX_WORKERS=1
READORI_VALIDATOR_MAX_JOBS=1
READORI_VALIDATOR_DOMAIN_CONCURRENCY=1
READORI_VALIDATOR_MAX_SOURCES=20000
READORI_VALIDATOR_MAX_UPLOAD_BYTES=67108864
READORI_AMD_WORK_DIR=/var/lib/readori-validator
PYTHONUNBUFFERED=1
